{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TaskBoard: uvicorn (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "TaskBoard: pytest (debug)",
      "type": "debugpy",
